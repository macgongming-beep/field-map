VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_NAVER_MAP_CLIENT_ID=your_naver_map_client_id

# 배포별 표시 정보. 다른 회중 배포에서는 반드시 자기 값으로 바꾼다.
VITE_APP_NAME=Field Map
VITE_APP_LABEL=YOUR_CONGREGATION
VITE_APP_URL=https://your-field-map.example.com/
VITE_APP_DESCRIPTION=회중 구역과 봉사 활동을 관리하는 Field Map입니다.

# 전시대 신청 DB 마이그레이션과 함께 켜는 선택 기능 (기본값: 꺼짐)
VITE_CART_APPLICATIONS_ENABLED=false

# 백업 스크립트용 (RLS 우회)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Web Push (VAPID 공개키)
# 생성: node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(k);"
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Sentry 에러 모니터링 (선택)
# https://sentry.io 가입 → 프로젝트 만들고 DSN 복사
# 없으면 자동으로 비활성화됨
VITE_SENTRY_DSN=https://...@o0.ingest.sentry.io/0

# Enable only after the meeting notes migration. Demo first; production stays off.
VITE_SERVICE_MEETING_NOTES_ENABLED=false

# Enable after 20261019_1200_restaurant_catalog.sql; false retains legacy reads.
# This is a build-time flag: rollback requires rebuilding and client update.
VITE_RESTAURANT_BROWSE_ENABLED=false

# Independent full-store refresh opt-ins; scoped recipients keep scope refresh.
# Unset inherits VITE_DEMO_MODE. Explicit false overrides demo mode.
# Build-time flags: changes require redeployment and client PWA update.
VITE_RETURN_VISIT_ADDRESS_REFRESH_ENABLED=false
VITE_BUILDING_CREATE_REFRESH_ENABLED=false
VITE_CALENDAR_EVENT_REFRESH_ENABLED=false
VITE_BUILDING_MOVE_REFRESH_ENABLED=false
# Shared calendar window, home detail, loading and store gate (same as production).
# Unset inherits demo; false disables all calendar windows. Rebuild/PWA update required.
VITE_CALENDAR_WINDOW_ENABLED=false
# Keep user return-detail store and calendar scope aligned; unset inherits demo.
# False restores full detail reads. Rebuild/redeploy and client update required.
VITE_RETURN_DETAIL_RETENTION_ENABLED=false
# Home selected-body read only; unset inherits demo, false disables even on demo.
VITE_HOME_SUGGESTION_BODY_ENABLED=false
# Card projection for actual users/leaders; administrators retain assignment dates.
# Unset inherits demo; build-time opt-in requires redeployment and client update.
VITE_CARD_COMPACT_READ_ENABLED=false
# Scoped details for actual users with a recipient reader; other roles retain full cards.
# Unset inherits demo; false overrides demo. Requires rebuild and client update.
# Shared-event names and restaurant directory load on demand.
VITE_RECIPIENT_CARD_SCOPE_ENABLED=false
# Personal recent sessions for actual user/leader/admin; developer history stays full.
# Unset inherits demo. Production opt-in needs review, rebuild and client update.
VITE_RECENT_SESSIONS_ENABLED=false
# Demo defaults on when unset; production remains opt-in after review.
VITE_SCOPED_VISIT_HISTORY_ENABLED=false
VITE_SETTINGS_CALENDAR_RETENTION_ENABLED=false
# Reuse complete covering calendar snapshots for navigation only; same two-minute TTL.
# Unset inherits demo. Foreground, realtime, writes and manual refresh still invalidate.
VITE_CALENDAR_NAVIGATION_REUSE_ENABLED=false
# Self application participant refresh. Independent of navigation reuse.
# Rollback: false + rebuild/redeploy; clients must apply the PWA update.
VITE_CALENDAR_APPLICATION_REFRESH_ENABLED=false
# Independent header read optimizations; unset inherits demo, false overrides demo.
# Notification panel and full chat lists still load their complete contents.
# Build-time flags: rollback requires rebuild/redeploy and client PWA update.
VITE_NOTIFICATION_BADGE_ONLY_ENABLED=false
VITE_CHAT_BADGE_ONLY_ENABLED=false
# Build-time opt-in; unset inherits demo, explicit false overrides demo.
# Requires scoped visit histories (actual user role + recipient store).
# False restores scoped history reads on every recovery.
# Thirty-minute full-history safety read and manual refresh remain available.
VITE_SCOPED_HISTORY_RECOVERY_ENABLED=false
# Coordinate visit writes and realtime building refreshes. Requires scoped
# history recovery above. Unset inherits demo; false restores independent reads.
# All three flags require rebuild/redeploy and client PWA update for rollback.
VITE_VISIT_REALTIME_QUEUE_ENABLED=false
# Complete calendar screen reuse (including full snapshots); no TTL extension.
# Requires calendar window + navigation reuse. Unset inherits demo; explicit
# false restores prior screen/loading behavior without disabling existing reuse.
VITE_CALENDAR_CACHED_SCREEN_ENABLED=false
# Independent opt-ins for navigation/home reductions; unset inherits demo,
# explicit false disables even in demo. Rollback requires rebuild and PWA update.
# Navigation recovery requires scoped history recovery, recipient scope and
# territory realtime. Does not narrow mutation or manual refresh paths.
VITE_CALENDAR_NAVIGATION_RECOVERY_ENABLED=false
# Only the retired notices slice; bell and maintenance notifications unchanged.
VITE_LEGACY_NOTICES_SKIP_ENABLED=false
# Requires the existing HOME_SUGGESTION_BODY home reader; admin full reads unchanged.
VITE_HOME_SUGGESTION_REUSE_ENABLED=false
# Home provider + API share this switch. Meeting feature must also be enabled.
# Explicit full/admin metadata reads do not reuse the home cache.
VITE_HOME_MEETING_META_REUSE_ENABLED=false
