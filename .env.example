VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_NAVER_MAP_CLIENT_ID=your_naver_map_client_id

# 배포별 표시 정보. 다른 회중 배포에서는 반드시 자기 값으로 바꾼다.
VITE_APP_NAME=Field Map
VITE_APP_LABEL=YOUR_CONGREGATION
VITE_APP_URL=https://your-field-map.example.com/
VITE_APP_DESCRIPTION=회중 구역과 봉사 활동을 관리하는 Field Map입니다.

# 전시대 신청 DB 마이그레이션과 함께 켜는 선택 기능 (기본값: 꺼짐)
VITE_CART_APPLICATIONS_ENABLED=false

# 백업 스크립트용 (RLS 우회)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Web Push (VAPID 공개키)
# 생성: node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(k);"
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Sentry 에러 모니터링 (선택)
# https://sentry.io 가입 → 프로젝트 만들고 DSN 복사
# 없으면 자동으로 비활성화됨
VITE_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
